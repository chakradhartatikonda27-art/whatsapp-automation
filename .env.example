# Environment Variables Configuration Example
# Copy this file to .env for local development or set variables in your deployment environment.

# System & General
PROJECT_NAME="WhatsApp Campaign SaaS"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
SECRET_KEY="super-secret-production-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL with RLS support)
POSTGRES_USER="whatsapp_user"
POSTGRES_PASSWORD="whatsapp_password"
POSTGRES_DB="whatsapp_saas"
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://whatsapp_user:whatsapp_password@postgres:5432/whatsapp_saas"
SYNC_DATABASE_URL="postgresql://whatsapp_user:whatsapp_password@postgres:5432/whatsapp_saas"

# Queue & Storage (Redis)
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_URL="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/1"

# WhatsApp Business API Provider Mode ("meta" or "mock")
# In local development without Meta credentials, set WHATSAPP_PROVIDER_MODE=mock
WHATSAPP_PROVIDER_MODE="mock"

# Meta WhatsApp Business Platform Credentials (Required when WHATSAPP_PROVIDER_MODE=meta)
WHATSAPP_API_VERSION="v20.0"
WHATSAPP_ACCESS_TOKEN="EAAG..."
WHATSAPP_BUSINESS_ACCOUNT_ID="100000000000000"
WHATSAPP_PHONE_NUMBER_ID="200000000000000"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="real_estate_whatsapp_webhook_secret_token_123"
WHATSAPP_APP_SECRET="0123456789abcdef0123456789abcdef"

# Storage
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET="whatsapp-campaigns"
STORAGE_ACCESS_KEY="minio_access_key"
STORAGE_SECRET_KEY="minio_secret_key"

# Frontend Integration
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_APP_NAME="PropConnect WhatsApp"
